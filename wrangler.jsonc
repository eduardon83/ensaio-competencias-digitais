// Configuração do Worker do ECD (Cloudflare). Instruções em README.txt → "Publicar na Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecd-ensaio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Criar com: npx wrangler kv namespace create TEXTOS  (e colar aqui o "id" devolvido)
  "kv_namespaces": [{ "binding": "TEXTOS", "id": "00000000000000000000000000000000" }],
  "observability": { "enabled": true }
}
