// Configuração do Worker do ECD (Cloudflare). Instruções em README.txt → "Publicar na Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecd-ensaio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Base KV "TEXTOS" (criada no painel da Cloudflare). O id não é secreto.
  "kv_namespaces": [{ "binding": "TEXTOS", "id": "a1c6457882e742e6ac65591c455cd860" }],
  // Limites de pedidos por chave (sem estado guardado): backoffice 30/min por IP; Aldeia Digital 60/min por IP,
  // 300 escritas/min por turma e 5 escritas em 10 s por aluno (o cliente agrupa as alterações).
  "ratelimits": [
    { "name": "LIMITE_CHAVES", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIMITE_ALDEIA", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_ALDEIA_TURMA", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
    { "name": "LIMITE_ALDEIA_ALUNO", "namespace_id": "1004", "simple": { "limit": 5, "period": 10 } }
  ],
  // Aldeia Digital: um Durable Object por turma (Turma), guarda de falhas e quotas por IP (Guarda) e registo global
  // (Registo). Segredos: PIMENTA_PROFESSOR, CHAVE_TOKENS, RESEND_CHAVE (ver docs/aldeia-digital/SEGURANCA.md).
  // Variáveis de texto (definidas no painel, mantidas entre publicações por "keep_vars"): ALDEIA_ESTADO, ALDEIA_TETO,
  // ALDEIA_REMETENTE, ALDEIA_RESPONDER, ALDEIA_EMAILS_DIA.
  "durable_objects": {
    "bindings": [
      { "name": "TURMAS", "class_name": "Turma" },
      { "name": "GUARDA", "class_name": "Guarda" },
      { "name": "REGISTO", "class_name": "Registo" }
    ]
  },
  "migrations": [{ "tag": "aldeia-v1", "new_sqlite_classes": ["Turma", "Guarda", "Registo"] }],
  "keep_vars": true,
  "observability": { "enabled": true },
  // Ambiente de testes separado (npx wrangler deploy --env testes): outro Worker, outros objetos e o mesmo KV de textos.
  "env": {
    "testes": {
      "name": "ecd-ensaio-testes",
      "kv_namespaces": [{ "binding": "TEXTOS", "id": "a1c6457882e742e6ac65591c455cd860" }],
      "ratelimits": [
        { "name": "LIMITE_CHAVES", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "LIMITE_ALDEIA", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "LIMITE_ALDEIA_TURMA", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } },
        { "name": "LIMITE_ALDEIA_ALUNO", "namespace_id": "2004", "simple": { "limit": 5, "period": 10 } }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "TURMAS", "class_name": "Turma" },
          { "name": "GUARDA", "class_name": "Guarda" },
          { "name": "REGISTO", "class_name": "Registo" }
        ]
      },
      "migrations": [{ "tag": "aldeia-v1", "new_sqlite_classes": ["Turma", "Guarda", "Registo"] }]
    }
  }
}
