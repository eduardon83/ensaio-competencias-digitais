// Configuração do Worker do ECD (Cloudflare). Instruções em README.txt → "Publicar na Cloudflare".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecd-ensaio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Base KV "TEXTOS" (criada no painel da Cloudflare). O id não é secreto.
  "kv_namespaces": [{ "binding": "TEXTOS", "id": "a1c6457882e742e6ac65591c455cd860" }],
  // Limite de pedidos com chave (backoffice): 30 por minuto por endereço IP.
  "ratelimits": [{ "name": "LIMITE_CHAVES", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": true }
}
